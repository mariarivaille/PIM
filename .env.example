# --- Telegram ---
TELEGRAM_BOT_TOKEN=123456:ABC...
# Telegram user id через запятую; пусто = бот открыт всем (не рекомендуется)
ALLOWED_USER_IDS=

# --- LLM ---
# openrouter | gigachat
LLM_PROVIDER=gigachat

# OpenRouter (OpenAI-совместимый API)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=qwen/qwen3-235b-a22b-2507
# OPENROUTER_MODEL=google/gemini-2.5-flash

# GigaChat
GIGACHAT_CREDENTIALS=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat-2-Max
GIGACHAT_VERIFY_SSL=false

# --- App ---
DATABASE_URL=sqlite+aiosqlite:///./aid.db
DEFAULT_TIMEZONE=Europe/Moscow
REMINDER_POLL_SECONDS=30
# через сколько минут тишины бот забывает контекст диалога (задачи не трогаются)
HISTORY_TTL_MINUTES=60
LOG_LEVEL=INFO
