# --- Telegram ---
TELEGRAM_BOT_TOKEN=123456:ABC...
# Telegram user id через запятую; пусто = бот открыт всем (не рекомендуется)
ALLOWED_USER_IDS=

# --- LLM ---
# openrouter | gigachat
LLM_PROVIDER=gigachat

# OpenRouter (OpenAI-совместимый API)
OPENROUTER_API_KEY=
# для фото → дела нужна модель с поддержкой картинок (gemini умеет, qwen3-235b — нет)
OPENROUTER_MODEL=qwen/qwen3-235b-a22b-2507
# OPENROUTER_MAX_TOKENS=2048
# Поиск в интернете через OpenRouter (нужен OPENROUTER_API_KEY, ~$0.01 за поиск); off — выключить
# WEB_SEARCH=openrouter
# Telegram Mini App (дела, календарь, память): публичный HTTPS-адрес; пусто — выключено.
# API слушает WEB_HOST:WEB_PORT (по умолчанию 127.0.0.1:8080), HTTPS снаружи — Caddy (deploy/README.md)
# WEBAPP_URL=https://203-0-113-5.sslip.io
# WEB_SEARCH_PER_TURN=3
# OPENROUTER_MODEL=google/gemini-2.5-flash

# GigaChat
GIGACHAT_CREDENTIALS=
# Вместо ключа авторизации можно дать готовый access-токен (истекает, бот его не обновляет)
GIGACHAT_ACCESS_TOKEN=
# Адрес API, если нужен не стандартный
GIGACHAT_BASE_URL=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat-2-Max
GIGACHAT_VERIFY_SSL=false

# --- Голосовые ---
# openrouter (Gemini через OpenRouter, нужен OPENROUTER_API_KEY) | whisper (локально, ~1.5 ГБ RAM,
# pip install -e ".[whisper]") | none
STT_PROVIDER=openrouter
STT_MODEL=google/gemini-3.5-flash-lite
# для STT_PROVIDER=whisper:
# WHISPER_MODEL=large-v3-turbo
# WHISPER_CPU_THREADS=4
MAX_VOICE_SECONDS=300

# --- App ---
DATABASE_URL=sqlite+aiosqlite:///./pim.db
DEFAULT_TIMEZONE=Europe/Moscow
REMINDER_POLL_SECONDS=30
# через сколько минут тишины бот забывает контекст диалога (задачи не трогаются)
HISTORY_TTL_MINUTES=60
# через сколько минут тишины бот разбирает разговор и сам запоминает важное
REFLECTION_IDLE_MINUTES=10
# максимум фактов в памяти на пользователя
MAX_MEMORIES=150
LOG_LEVEL=INFO
